<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>对局分析 — {{ v.white }} vs {{ v.black }}</title>
<style>
  :root { --ink:#1a1a1a; --muted:#666; --line:#e2e2e2; --red:#c62828; --green:#2e7d32; --bg:#fafafa; }
  * { box-sizing: border-box; }
  body { font-family: -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
         color: var(--ink); margin: 0; background: var(--bg); line-height: 1.5; }
  .wrap { max-width: 960px; margin: 0 auto; padding: 32px 24px 64px; }
  h1 { font-size: 26px; margin: 0 0 4px; }
  h2 { font-size: 19px; margin: 32px 0 12px; border-bottom: 2px solid var(--ink); padding-bottom: 6px; }
  .meta { color: var(--muted); font-size: 14px; margin-bottom: 16px; }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .card { background: #fff; border: 1px solid var(--line); border-radius: 8px; padding: 16px; }
  .card h3 { margin: 0 0 8px; font-size: 16px; }
  .stat { font-size: 13px; color: var(--muted); }
  .big { font-size: 22px; font-weight: 700; }
  table { border-collapse: collapse; width: 100%; font-size: 13px; }
  th, td { text-align: left; padding: 5px 8px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; }
  .callout { background: #fff8e1; border-left: 4px solid #f9a825; padding: 12px 16px;
             border-radius: 4px; margin: 12px 0; font-size: 14px; }
  .summary { background:#fff; border:1px solid var(--line); border-radius: 10px;
             padding: 18px 20px; margin: 18px 0; }
  .summary .headline { font-size: 18px; font-weight: 800; line-height: 1.4; }
  .summary .sub { color: var(--muted); font-size: 13px; margin: 6px 0 14px; }
  .summary .sgrid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; }
  .summary .sbox { border-radius: 8px; padding: 12px 14px; }
  .summary .sbox h4 { margin: 0 0 8px; font-size: 14px; }
  .summary .sbox ul { margin: 0; padding-left: 18px; font-size: 13px; }
  .summary .sbox li { margin-bottom: 5px; }
  .summary .good { background:#e8f5e9; }
  .summary .bad { background:#fdecea; }
  .summary .advice { background:#e3f2fd; }
  .moment { display: grid; grid-template-columns: 340px 1fr; gap: 20px; align-items: start;
            border: 1px solid var(--line); background:#fff; border-radius: 8px; padding: 16px; margin: 14px 0; }
  .moment .board svg { width: 100%; height: auto; }
  .tag { display:inline-block; font-size:11px; padding:2px 8px; border-radius: 10px; margin-right:6px; }
  .tag.blunder { background:#fdecea; color: var(--red); }
  .tag.mistake { background:#fff3e0; color:#e65100; }
  .tag.inaccuracy { background:#fffde7; color:#9e7d00; }
  .tag.phase { background:#eef2f7; color:#37474f; }
  .played { color: var(--red); font-weight: 700; }
  .best { color: var(--green); font-weight: 700; }
  .lbl { font-weight: 700; color:#37474f; }
  .opening { background:#fff; border:1px solid var(--line); border-radius:10px; padding:14px 20px; margin:14px 0; }
  .opening ul { margin:0; padding-left:20px; font-size:14px; }
  .opening li { margin-bottom:7px; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size:13px; background:#f4f4f4; padding:1px 5px; border-radius:4px; }
  h2.persp { margin-top:40px; background:#1a1a1a; color:#fff; padding:8px 14px; border:0; border-radius:6px; }
  h3 { font-size:16px; margin:22px 0 10px; }
  a { color:#1565c0; text-decoration: none; }
  a:hover { text-decoration: underline; }
  @media (max-width: 680px) { .cards, .moment, .summary .sgrid { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<div class="wrap">
  <h1>{{ v.white }} &nbsp;vs&nbsp; {{ v.black }}</h1>
  <div class="meta">
    {% if v.event %}{{ v.event }} · {% endif %}
    {% if v.date %}{{ v.date }} · {% endif %}
    结果 {{ v.result }}
    {% if v.eco or v.opening_name %} · {{ v.eco }} {{ v.opening_name }}{% endif %}
    {% if v.focus %} · 关注方：{{ v.focus }}{% endif %}
  </div>

  {% macro summary_block(sm) %}
  <div class="summary">
    <div class="headline">{{ sm.headline }}</div>
    <div class="sub">总结对象：{{ sm.focus_name }}（{{ sm.side }} · {{ sm.result_text }} · ACPL {{ sm.acpl }}）</div>
    <div class="sgrid">
      <div class="sbox good"><h4>做得好的</h4><ul>
        {% for item in sm.good %}<li>{{ item }}</li>{% endfor %}
      </ul></div>
      <div class="sbox bad"><h4>做得不好的</h4><ul>
        {% for item in sm.bad %}<li>{{ item }}</li>{% endfor %}
      </ul></div>
      <div class="sbox advice"><h4>训练建议</h4><ul>
        {% for item in sm.advice %}<li>{{ item }}</li>{% endfor %}
      </ul></div>
    </div>
  </div>
  {% endmacro %}

  {% macro turning_block(t) %}
  <div class="callout">
    <strong>转折点：</strong>第 {{ t.move_number }} 回合（{{ t.side }}）
    <span class="played">{{ t.played }}</span>：
    评估 {{ t.eval_before }} → {{ t.eval_after }}
    （{{ t['for'] }}此后再没回来）；应走
    <span class="best">{{ t.best }}</span>。
    <a href="{{ t.lichess }}">打开分析</a>
  </div>
  {% endmacro %}

  {% macro moments_block(moments, empty_msg) %}
  {% if not moments %}<p class="stat">{{ empty_msg }}</p>{% endif %}
  {% for m in moments %}
  <div class="moment">
    <div class="board">{{ m.svg | safe }}</div>
    <div>
      <div>
        <span class="tag {{ m.classification }}">{{ m.class_zh }}</span>
        <span class="tag phase">{{ m.phase }}</span>
        <strong>第 {{ m.move_number }} 回合 · {{ m.side }}</strong>
      </div>
      <p>实走 <span class="played">{{ m.played }}</span>，
         应走 <span class="best">{{ m.best }}</span>
         （<strong>-{{ m.cp_loss }}cp</strong>；{{ m.eval_before }} → {{ m.eval_after }}）。</p>
      <p><span class="lbl">为什么错：</span>{{ m.explain.why }}</p>
      <p><span class="lbl">造成的后果：</span>{{ m.explain.consequence }}</p>
      <p><span class="lbl">应该怎么做：</span>{{ m.explain.what_to_do }}</p>
      <p><a href="{{ m.lichess }}">在 lichess 上打开这个局面 →</a></p>
    </div>
  </div>
  {% endfor %}
  {% endmacro %}

  {% macro phase_summary(phase_zh, moments) %}
  {% set bl = moments | selectattr('classification','equalto','blunder') | list | length %}
  {% set mi = moments | selectattr('classification','equalto','mistake') | list | length %}
  {% set inn = moments | selectattr('classification','equalto','inaccuracy') | list | length %}
  {% if moments | length == 0 %}
    <p class="stat">{{ phase_zh }}没有达到阈值的问题着法，走得比较稳。</p>
  {% else %}
    {% set parts = [] %}
    {% if bl %}{% set _ = parts.append(bl ~ ' 个漏着') %}{% endif %}
    {% if mi %}{% set _ = parts.append(mi ~ ' 个错着') %}{% endif %}
    {% if inn %}{% set _ = parts.append(inn ~ ' 个不精确') %}{% endif %}
    <p class="stat">{{ phase_zh }}出现 {{ parts | join('、') }}，下面逐条来看。</p>
  {% endif %}
  {% endmacro %}

  {% macro opening_block(sec) %}
  <div class="opening">
    <ul>
      {% if sec.eco or sec.name %}<li><b>开局定式：</b>{{ sec.eco }} {{ sec.name }}</li>{% endif %}
      {% if sec.line_played %}<li><b>实战着法：</b><span class="mono">{{ sec.line_played }}</span></li>{% endif %}
      {% if sec.deviation %}
        <li><b>首个脱谱点：</b>第 {{ sec.deviation.move_number }} 回合 {{ sec.deviation.side }} 走了
          <span class="played">{{ sec.deviation.played }}</span>。</li>
      {% elif sec.in_book_full %}
        <li><b>脱谱点：</b>全程跟随理论主线，没有脱谱。</li>
      {% endif %}
      {% if sec.book_choices %}
        <li><b>开局库续法{% if sec.anchor_move_number %}（第 {{ sec.anchor_move_number }} 回合{{ sec.anchor_side }}的选择点）{% endif %}（前两个选择，各续约 5 回合）：</b>
          <ul>
          {% for bc in sec.book_choices %}
            <li>{{ '首选' if loop.index0 == 0 else '次选' }} <span class="best">{{ bc.san }}</span>{% if bc.pct is not none %}（{{ bc.pct }}% 权重）{% endif %}：
              <span class="mono">{{ bc.line or bc.san }}</span>
              {% if bc.lichess %} · <a href="{{ bc.lichess }}">在 lichess 上打开 ↗</a>{% endif %}</li>
          {% endfor %}
          </ul>
        </li>
      {% endif %}
    </ul>
  </div>
  {% endmacro %}

  <!-- ===================== 一、总结 ===================== -->
  <h2>一、总结</h2>
  {% if v.summary_zh %}{{ summary_block(v.summary_zh) }}{% endif %}
  <div class="cards">
    {% for side in [v.white_summary, v.black_summary] %}
    <div class="card">
      <h3>{{ side.name }}</h3>
      <div><span class="big">{{ side.acpl }}</span> <span class="stat">平均每步损失(cp)</span></div>
      <div class="stat">漏着 {{ side.blunders }} · 错着 {{ side.mistakes }} · 不精确 {{ side.inaccuracies }}</div>
      <table style="margin-top:10px">
        <tr><th>阶段</th><th>ACPL</th><th>漏着</th><th>错着</th></tr>
        {% for ph in phases %}
        <tr><td>{{ phase_zh[ph] }}</td><td>{{ side.phases[ph].acpl }}</td>
            <td>{{ side.phases[ph].blunders }}</td><td>{{ side.phases[ph].mistakes }}</td></tr>
        {% endfor %}
      </table>
    </div>
    {% endfor %}
  </div>
  {% if v.turning_point %}{{ turning_block(v.turning_point) }}{% endif %}

  <!-- ===================== 二、开局板块 ===================== -->
  <h2>二、开局板块</h2>
  {{ opening_block(v.opening_section) }}
  {% set open_m = v.critical_moments | selectattr('phase_key','equalto','opening') | list %}
  {% if open_m %}
  <h3>开局阶段问题着法</h3>
  {{ moments_block(open_m, '') }}
  {% endif %}

  {% if v.dual and v.perspectives %}
    {% for p in v.perspectives %}
    <h2 class="persp">【{{ p.side }}视角】{{ p.name }}</h2>
    {% set mid_m = p.critical_moments | selectattr('phase_key','equalto','middlegame') | list %}
    {% set end_m = p.critical_moments | selectattr('phase_key','equalto','endgame') | list %}
    {% if mid_m %}
    <h3>中局板块</h3>
    {{ phase_summary('中局', mid_m) }}
    {{ moments_block(mid_m, '') }}
    {% endif %}
    {% if end_m %}
    <h3>残局板块</h3>
    {{ phase_summary('残局', end_m) }}
    {{ moments_block(end_m, '') }}
    {% endif %}
    {% endfor %}
  {% else %}
    {% set mid_m = v.critical_moments | selectattr('phase_key','equalto','middlegame') | list %}
    {% set end_m = v.critical_moments | selectattr('phase_key','equalto','endgame') | list %}
    {% if mid_m %}
    <h2>三、中局板块</h2>
    {{ phase_summary('中局', mid_m) }}
    {{ moments_block(mid_m, '') }}
    {% endif %}
    {% if end_m %}
    <h2>四、残局板块</h2>
    {{ phase_summary('残局', end_m) }}
    {{ moments_block(end_m, '') }}
    {% endif %}
  {% endif %}

  <p class="stat" style="margin-top:40px">绿箭 = 引擎最佳着法 · 红箭 = 实走。由 chess-review 生成。</p>
</div>
</body>
</html>
